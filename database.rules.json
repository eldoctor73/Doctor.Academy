{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "downloads": {
      "Downloads": {
        ".read": true,
        "link1": { ".write": true },
        "link2": { ".write": true },
        "link3": { ".write": true }
      }
    },
    "version": {
      ".read": true
    }
  }
}
